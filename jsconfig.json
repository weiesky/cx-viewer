{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "strictNullChecks": false
  },
  "include": [
    "packages/**/*",
    "apps/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist"
  ]
}
