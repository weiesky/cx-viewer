{
  "name": "cx-viewer-workspace",
  "version": "1.1.20",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm --filter @cxv/web dev",
    "start": "pnpm --filter cx-viewer start",
    "build": "pnpm --filter @cxv/web build && pnpm --filter cx-viewer exec node scripts/assemble-dist.mjs",
    "build:sourcemap": "CXV_SOURCEMAP=1 pnpm run build",
    "test": "pnpm -r --no-bail --workspace-concurrency=1 --if-present test && pnpm run test:integration",
    "pack:dry-run": "pnpm --filter cx-viewer run pack:dry-run",
    "release:check": "pnpm run build && pnpm test && pnpm run pack:dry-run && pnpm run verify:tarball",
    "check:ultraplan-presets": "pnpm --filter cx-viewer run check:ultraplan-presets",
    "sync:ultraplan-presets": "pnpm --filter cx-viewer run sync:ultraplan-presets",
    "verify:codex-ask": "pnpm --filter cx-viewer run verify:codex-ask",
    "electron:dev": "pnpm --filter @cxv/electron dev",
    "electron:build": "pnpm run build && pnpm --filter @cxv/electron build",
    "electron:sign": "pnpm run build && pnpm --filter @cxv/electron sign",
    "electron:check-sign": "pnpm --filter @cxv/electron check-sign",
    "test:coverage": "c8 --all --reporter=text --include=\"packages/app/**/*.js\" --include=\"apps/web/src/**/*.js\" --include=\"apps/electron/electron/*.js\" pnpm test",
    "test:coverage:html": "c8 --all --reporter=html --include=\"packages/app/**/*.js\" --include=\"apps/web/src/**/*.js\" --include=\"apps/electron/electron/*.js\" pnpm test",
    "test:integration": "CXV_TEST=1 CXV_LOG_DIR=tmp node scripts/test-integration.mjs",
    "verify:tarball": "node scripts/verify-tarball-contract.mjs",
    "verify:mac-keychain": "node --test apps/electron/tests/mac-keychain.test.js",
    "verify:tarball-drift": "node scripts/verify-tarball-drift.mjs",
    "pretest": "pnpm run verify:boundaries && pnpm run verify:tarball-drift",
    "pretest:integration": "pnpm run verify:boundaries && pnpm run verify:tarball-drift",
    "verify:boundaries": "node scripts/verify-boundaries.mjs"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "@openai/codex-sdk": "0.142.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0",
    "dingtalk-stream": "2.1.5",
    "dompurify": "^3.3.3",
    "jszip": "^3.10.1",
    "node-pty": "^1.1.0",
    "undici": "^7.22.0",
    "ws": "^8.19.0",
    "@changesets/cli": "3.0.0",
    "acorn": "^8.16.0",
    "acorn-jsx": "^5.3.2"
  }
}
